# Frontend (Vite) - optional. Chain the app asks the wallet to switch to when the
# connected network has no DutchPoint deployment. 31337 = local Hardhat, 11155111 = Sepolia.
VITE_DEFAULT_CHAIN_ID=31337

# Sepolia deployment secrets are NOT read from this file. Store them in the Hardhat keystore:
#   npm run keystore -- set SEPOLIA_RPC_URL
#   npm run keystore -- set SEPOLIA_PRIVATE_KEY   (a throwaway test wallet only)
#   npm run keystore -- set ETHERSCAN_API_KEY
# or export them as environment variables in your shell before running npm run deploy:sepolia.
